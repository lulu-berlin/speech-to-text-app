root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.kt]
indent_style = space
indent_size = 4

[*.kts]
indent_style = space
indent_size = 4

# Flyway names its class migrations `V<version>__<Description>`; the tool's contract wins over Kotlin naming.
[backend/src/main/kotlin/stt/db/migration/*.kt]
ktlint_standard_class-naming = disabled

[*.{ts,tsx,js,jsx,json,yml,yaml,md}]
indent_style = space
indent_size = 2
