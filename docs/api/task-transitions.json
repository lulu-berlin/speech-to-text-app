{
  "transitions": {
    "QUEUED": ["RUNNING", "PAUSED", "FAILED", "CANCELED"],
    "RUNNING": ["QUEUED", "PAUSED", "COMPLETED", "FAILED", "CANCELED"],
    "PAUSED": ["QUEUED", "CANCELED"],
    "COMPLETED": [],
    "FAILED": ["QUEUED"],
    "CANCELED": ["QUEUED"]
  },
  "commands": {
    "pause": { "from": ["QUEUED", "RUNNING"], "to": "PAUSED" },
    "resume": { "from": ["PAUSED"], "to": "QUEUED" },
    "cancel": { "from": ["QUEUED", "RUNNING", "PAUSED"], "to": "CANCELED" },
    "retry": { "from": ["FAILED", "CANCELED"], "to": "QUEUED" }
  }
}
