# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Git worktrees for subagent tasks (only the README is tracked)
/workspaces/*
!/workspaces/README.md

# Agent working files (per-session state, never committed)
handoff.md

# Build outputs (roadmap item 02)
build/
.gradle/
.kotlin/
node_modules/
dist/
result

# Heap dumps: a test that runs out of memory on purpose (item 71's heap bound) or a crashed worker
# writes one into the working directory, and it is hundreds of megabytes.
*.hprof

# The e2e backend log (roadmap item 48: the macOS CI greps it for the whisper backend)
/e2e/.e2e-backend.log
