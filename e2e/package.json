{
  "name": "stt-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test lib/processes.test.ts lib/fixtures.test.ts lib/type-check.test.ts && node check-playwright.ts && prettier --check . && tsc -p tsconfig.json && playwright test",
    "record:gifs": "playwright test --config=playwright.gifs.config.ts",
    "test:desktop": "tsc -p tsconfig.json && node desktop/run-in-docker.ts",
    "test:desktop:nix": "tsc -p tsconfig.json && node desktop/run-in-docker.ts --nix",
    "test:desktop:bundle": "tsc -p tsconfig.json && node desktop/run-in-docker.ts --bundle",
    "test:desktop:bundle:amd": "tsc -p tsconfig.json && node desktop/run-in-docker.ts --bundle --amd-gpu",
    "test:desktop:bundle:nvidia": "tsc -p tsconfig.json && node desktop/run-in-docker.ts --bundle --nvidia-gpu",
    "test:desktop:deb-floor": "tsc -p tsconfig.json && node desktop/run-in-docker.ts --deb-floor",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
